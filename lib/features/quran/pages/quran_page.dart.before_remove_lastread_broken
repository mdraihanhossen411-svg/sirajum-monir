import 'package:flutter/material.dart';

import '../controllers/quran_controller.dart';
import '../models/quran_model.dart';
import '../services/quran_service.dart';
import 'bookmark_page.dart';
import 'juz_page.dart';
import 'surah_detail_page.dart';
import 'surah_list_page.dart';

class QuranPage extends StatefulWidget {
  const QuranPage({super.key});

  @override
  State<QuranPage> createState() => _QuranPageState();
}

class _QuranPageState extends State<QuranPage> {
final TextEditingController _surahSearchController =
      TextEditingController();
  final TextEditingController _ayahSearchController =
      TextEditingController();

  SurahModel? _selectedSurah;
  List<SurahModel> _allSurahs = [];

  @override
  void initState() {
    super.initState();
    _loadSearchSurahs();
  }

  Future<void> _loadSearchSurahs() async {
    try {
      final metadata = await QuranService().loadSurahList();

      final surahs = metadata
          .cast<Map>()
          .map(
            (item) => SurahModel.fromJson(
              Map<String, dynamic>.from(item),
            ),
          )
          .toList();

      if (!mounted) return;

      setState(() {
        _allSurahs = surahs;
      });
    } catch (_) {}
  }

  @override
  void dispose() {
    _surahSearchController.dispose();
    _ayahSearchController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return DefaultTabController(
      length: 3,
      child: Scaffold(
        appBar: AppBar(
          title: const Text(
            'আল-কুরআন',
            style: TextStyle(
              fontWeight: FontWeight.bold,
            ),
          ),
          bottom:
              const PreferredSize(
            preferredSize:
                Size.fromHeight(118),
            child: SizedBox.shrink(),
          ),
          flexibleSpace:
              SafeArea(
            child: Column(
              children: [
                const SizedBox(height: 48),
                _searchSection(),
              ],
            ),
          ),
        ),
        body: Column(
                children: [
                                const Expanded(
                    child: TabBarView(
                      children: [
                        SurahListPage(),
                        JuzPage(),
                        BookmarkPage(),
                      ],
                    ),
                  ),
                ],
              ),
      ),
    );
  }
}
