import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';
import '../controllers/quran_controller.dart';
import '../controllers/search_controller.dart';
import '../models/quran_model.dart';
import '../services/quran_service.dart';

import 'bookmark_page.dart';
import 'juz_page.dart';
import 'search_quran_page.dart';
import 'surah_list_page.dart';

class QuranPage extends StatefulWidget {
  const QuranPage({super.key});

  @override
  State<QuranPage> createState() => _QuranPageState();
}

class _QuranPageState extends State<QuranPage> {
  final QuranSearchController _searchController = QuranSearchController();

  final TextEditingController _textController = TextEditingController();

  @override
  void initState() {
    super.initState();
    _searchController.load();
  }

  @override
  void dispose() {
    _textController.dispose();
    _searchController.dispose();
    super.dispose();
  }

  Future<SurahModel?> _loadLastReadSurah() async {
    final prefs = await SharedPreferences.getInstance();
    final surahId = prefs.getInt('quran_last_read_surah');
    final ayahNumber = prefs.getInt('quran_last_read_ayah');

    if (surahId == null || ayahNumber == null) return null;

    try {
      final data = await QuranService().loadSurahCore(surahId);

      return SurahModel(
        id: surahId,
        arabicName: data['arabicName'] as String? ?? '',
        englishName: data['englishName'] as String? ?? '',
        banglaName: QuranController.banglaSurahName(surahId),
        totalAyah: data['totalAyah'] as int? ?? 0,
        revelationType: '',
      );
    } catch (_) {
      return null;
    }
  }

  Future<int?> _getLastReadAyah() async {
    final prefs = await SharedPreferences.getInstance();
    return prefs.getInt('quran_last_read_ayah');
  }

  Widget _lastReadBanner() {
    return FutureBuilder<List<dynamic>>(
      future: Future.wait([_loadLastReadSurah(), _getLastReadAyah()]),
      builder: (context, snapshot) {
        if (!snapshot.hasData) {
          return const SizedBox.shrink();
        }

        final surah = snapshot.data![0] as SurahModel?;
        final ayah = snapshot.data![1] as int?;

        if (surah == null || ayah == null) {
          return const SizedBox.shrink();
        }

        return Container(
          margin: const EdgeInsets.fromLTRB(12, 10, 12, 4),
          padding: const EdgeInsets.fromLTRB(14, 11, 10, 11),
          decoration: BoxDecoration(
            color: const Color(0xFF0A8754).withValues(alpha: 0.07),
            borderRadius: BorderRadius.circular(16),
            border: Border.all(
              color: const Color(0xFFC9A227).withValues(alpha: 0.35),
            ),
          ),
          child: InkWell(
            borderRadius: BorderRadius.circular(12),
            onTap: () {
              Navigator.pushNamed(
                context,
                '/quran/surah',
                arguments: {'surah': surah, 'initialAyah': ayah},
              );
            },
            child: Row(
              children: [
                Container(
                  width: 38,
                  height: 38,
                  decoration: const BoxDecoration(
                    color: Color(0xFF0A8754),
                    shape: BoxShape.circle,
                  ),
                  child: const Icon(
                    Icons.history_rounded,
                    color: Colors.white,
                    size: 20,
                  ),
                ),
                const SizedBox(width: 11),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'শেষ পঠিত',
                        style: TextStyle(
                          fontSize: 12,
                          color: Color(0xFF075F3B),
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                      const SizedBox(height: 2),
                      Text(
                        'সূরা ${surah.banglaName} • আয়াত $ayah',
                        maxLines: 1,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(
                          fontSize: 15,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                ),
                const Icon(
                  Icons.arrow_forward_ios_rounded,
                  size: 16,
                  color: Color(0xFF0A8754),
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  Widget _searchModeButton(String text, QuranSearchMode mode) {
    final selected = _searchController.mode == mode;
    return InkWell(
      onTap: () {
        _textController.clear();
        _searchController.setMode(mode);
      },
      borderRadius: BorderRadius.circular(10),
      child: Container(
        padding: const EdgeInsets.symmetric(vertical: 7),
        decoration: BoxDecoration(
          color: selected ? Colors.white : Colors.white24,
          borderRadius: BorderRadius.circular(10),
        ),
        child: Text(
          text,
          textAlign: TextAlign.center,
          style: TextStyle(
            color: selected ? const Color(0xFF0A8754) : Colors.white,
            fontWeight: FontWeight.bold,
          ),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return DefaultTabController(
      length: 3,
      child: Scaffold(
        appBar: AppBar(
          backgroundColor: const Color(0xFF0A8754),
          centerTitle: true,
          title: const Text(
            'আল-কুরআন',
            style: TextStyle(fontWeight: FontWeight.bold),
          ),
          bottom: PreferredSize(
            preferredSize: const Size.fromHeight(150),
            child: Column(
              children: [
                Padding(
                  padding: const EdgeInsets.fromLTRB(12, 4, 12, 8),
                  child: TextField(
                    controller: _textController,
                    onChanged: _searchController.search,
                    style: const TextStyle(color: Colors.black87),
                    decoration: InputDecoration(
                      hintText: _searchController.mode == QuranSearchMode.surah
                          ? 'সূরার নাম বা নম্বর লিখুন...'
                          : 'আয়াতের বাংলা অর্থ বা আরবি লিখুন...',
                      prefixIcon: const Icon(Icons.search),
                      suffixIcon: ValueListenableBuilder<TextEditingValue>(
                        valueListenable: _textController,
                        builder: (context, value, _) {
                          if (value.text.isEmpty) {
                            return const SizedBox.shrink();
                          }

                          return IconButton(
                            icon: const Icon(Icons.clear),
                            onPressed: () {
                              _textController.clear();
                              _searchController.search('');
                            },
                          );
                        },
                      ),
                      filled: true,
                      fillColor: Colors.white,
                      contentPadding: const EdgeInsets.symmetric(
                        vertical: 4,
                        horizontal: 12,
                      ),
                      border: OutlineInputBorder(
                        borderRadius: BorderRadius.circular(14),
                        borderSide: BorderSide.none,
                      ),
                    ),
                  ),
                ),
                Padding(
                  padding: const EdgeInsets.fromLTRB(12, 0, 12, 8),
                  child: AnimatedBuilder(
                    animation: _searchController,
                    builder: (context, _) => Row(
                      children: [
                        Expanded(
                          child: _searchModeButton(
                            'সূরা সার্চ',
                            QuranSearchMode.surah,
                          ),
                        ),
                        const SizedBox(width: 6),
                        Expanded(
                          child: _searchModeButton(
                            'আয়াত সার্চ',
                            QuranSearchMode.ayah,
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
                const TabBar(
                  indicatorColor: Colors.white,
                  tabs: [
                    Tab(icon: Icon(Icons.menu_book), text: 'সূরা'),
                    Tab(icon: Icon(Icons.book), text: 'পারা'),
                    Tab(icon: Icon(Icons.bookmark), text: 'বুকমার্ক'),
                  ],
                ),
              ],
            ),
          ),
        ),
        body: AnimatedBuilder(
          animation: _searchController,
          builder: (context, _) {
            if (_searchController.query.trim().isNotEmpty ||
                _searchController.mode == QuranSearchMode.surah) {
              return SearchQuranPage(controller: _searchController);
            }

            return Column(
              children: [
                _lastReadBanner(),
                const Expanded(
                  child: TabBarView(
                    children: [SurahListPage(), JuzPage(), BookmarkPage()],
                  ),
                ),
              ],
            );
          },
        ),
      ),
    );
  }
}
