import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';

import '../controllers/quran_controller.dart';
import '../controllers/search_controller.dart';
import '../models/quran_model.dart';
import '../services/quran_service.dart';
import 'bookmark_page.dart';
import 'juz_page.dart';
import 'surah_detail_page.dart';
import 'surah_list_page.dart';

class QuranPage extends StatefulWidget {
  const QuranPage({super.key});

  @override
  State<QuranPage> createState() => _QuranPageState();
}

class _QuranPageState extends State<QuranPage> {
  final QuranSearchController _searchController =
      QuranSearchController();

  final TextEditingController _textController =
      TextEditingController();

  QuranSearchMode _mode = QuranSearchMode.surah;
  bool _searching = false;

  @override
  void initState() {
    super.initState();
    _searchController.load();
  }

  @override
  void dispose() {
    _textController.dispose();
    _searchController.dispose();
    super.dispose();
  }

  Future<SurahModel?> _loadLastReadSurah() async {
    final prefs = await SharedPreferences.getInstance();

    final surahId = prefs.getInt('quran_last_read_surah');
    final ayahNumber = prefs.getInt('quran_last_read_ayah');

    if (surahId == null || ayahNumber == null) return null;

    try {
      final data =
          await QuranService().loadSurahCore(surahId);

      return SurahModel(
        id: surahId,
        arabicName: data['arabicName'] as String? ?? '',
        englishName: data['englishName'] as String? ?? '',
        banglaName:
            QuranController.banglaSurahName(surahId),
        totalAyah:
            data['totalAyah'] as int? ?? 0,
        revelationType: '',
      );
    } catch (_) {
      return null;
    }
  }

  Future<int?> _getLastReadAyah() async {
    final prefs = await SharedPreferences.getInstance();
    return prefs.getInt('quran_last_read_ayah');
  }

  Widget _lastReadBanner() {
    return FutureBuilder<List<dynamic>>(
      future: Future.wait([
        _loadLastReadSurah(),
        _getLastReadAyah(),
      ]),
      builder: (context, snapshot) {
        if (!snapshot.hasData) {
          return const SizedBox.shrink();
        }

        final surah =
            snapshot.data![0] as SurahModel?;
        final ayah =
            snapshot.data![1] as int?;

        if (surah == null || ayah == null) {
          return const SizedBox.shrink();
        }

        return Container(
          margin:
              const EdgeInsets.fromLTRB(12, 10, 12, 6),
          padding:
              const EdgeInsets.all(12),
          decoration: BoxDecoration(
            color: const Color(0xFF0A8754)
                .withValues(alpha: 0.08),
            borderRadius:
                BorderRadius.circular(16),
            border: Border.all(
              color: const Color(0xFFC9A227)
                  .withValues(alpha: 0.4),
            ),
          ),
          child: InkWell(
            borderRadius:
                BorderRadius.circular(12),
            onTap: () {
              Navigator.push(
                context,
                MaterialPageRoute(
                  builder: (_) =>
                      SurahDetailPage(
                    surah: surah,
                    initialAyah: ayah,
                  ),
                ),
              );
            },
            child: Row(
              children: [
                Container(
                  width: 40,
                  height: 40,
                  decoration:
                      const BoxDecoration(
                    color: Color(0xFF0A8754),
                    shape: BoxShape.circle,
                  ),
                  child: const Icon(
                    Icons.history_rounded,
                    color: Colors.white,
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: Column(
                    crossAxisAlignment:
                        CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'শেষ পঠিত',
                        style: TextStyle(
                          fontSize: 12,
                          color: Color(0xFF075F3B),
                          fontWeight:
                              FontWeight.w600,
                        ),
                      ),
                      const SizedBox(height: 2),
                      Text(
                        'সূরা ${surah.banglaName} • আয়াত $ayah',
                        maxLines: 1,
                        overflow:
                            TextOverflow.ellipsis,
                        style:
                            const TextStyle(
                          fontSize: 15,
                          fontWeight:
                              FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                ),
                const Icon(
                  Icons.arrow_forward_ios_rounded,
                  size: 16,
                  color: Color(0xFF0A8754),
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  void _setMode(QuranSearchMode mode) {
    setState(() {
      _mode = mode;
      _textController.clear();
      _searching = false;
    });
  }

  void _performSearch() {
    final query = _textController.text.trim();

    if (query.isEmpty) {
      setState(() {
        _searching = false;
      });
      return;
    }

    setState(() {
      _searching = true;
    });

    if (_mode == QuranSearchMode.surah) {
      _searchController.setMode(
        QuranSearchMode.surah,
      );
      _searchController.search(query);
      return;
    }

    _searchAyah(query);
  }

  Future<void> _searchAyah(String query) async {
    final normalized = _toEnglishDigits(query)
        .replaceAll(' ', '');

    final match = RegExp(
      r'^(\d+):(\d+)$',
    ).firstMatch(normalized);

    if (match == null) {
      _showMessage(
        'আয়াত লিখুন এইভাবে: 2:255',
      );
      return;
    }

    final surahId =
        int.tryParse(match.group(1)!);
    final ayahNumber =
        int.tryParse(match.group(2)!);

    if (surahId == null ||
        ayahNumber == null ||
        surahId < 1 ||
        surahId > 114) {
      _showMessage(
        'সঠিক সূরা নম্বর দিন।',
      );
      return;
    }

    try {
      final data = await QuranService()
          .loadSurahCore(surahId);

      final totalAyah =
          data['totalAyah'] as int? ?? 0;

      if (ayahNumber < 1 ||
          ayahNumber > totalAyah) {
        _showMessage(
          'এই সূরায় $ayahNumber নম্বর আয়াত নেই।',
        );
        return;
      }

      final surah = SurahModel(
        id: surahId,
        arabicName:
            data['arabicName'] as String? ?? '',
        englishName:
            data['englishName'] as String? ?? '',
        banglaName:
            QuranController
                .banglaSurahName(surahId),
        totalAyah: totalAyah,
        revelationType: '',
      );

      if (!mounted) return;

      Navigator.push(
        context,
        MaterialPageRoute(
          builder: (_) => SurahDetailPage(
            surah: surah,
            initialAyah: ayahNumber,
          ),
        ),
      );
    } catch (_) {
      _showMessage(
        'আয়াত খুঁজে পাওয়া যায়নি।',
      );
    }
  }

  String _toEnglishDigits(String value) {
    const bangla = '০১২৩৪৫৬৭৮৯';
    const english = '0123456789';

    var result = value;

    for (var i = 0; i < 10; i++) {
      result = result.replaceAll(
        bangla[i],
        english[i],
      );
    }

    return result;
  }

  void _showMessage(String message) {
    if (!mounted) return;

    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(
        SnackBar(
          content: Text(message),
          behavior:
              SnackBarBehavior.floating,
        ),
      );
  }

  Widget _searchSection() {
    return Container(
      padding:
          const EdgeInsets.fromLTRB(12, 8, 12, 10),
      child: Column(
        children: [
          TextField(
            controller: _textController,
            textInputAction:
                TextInputAction.search,
            onSubmitted: (_) =>
                _performSearch(),
            decoration: InputDecoration(
              hintText:
                  _mode == QuranSearchMode.surah
                      ? 'সূরার নাম বা নম্বর লিখুন'
                      : 'সূরা:আয়াত লিখুন  (যেমন 2:255)',
              prefixIcon:
                  const Icon(Icons.search),
              suffixIcon: IconButton(
                icon:
                    const Icon(Icons.check_circle),
                color:
                    const Color(0xFFC9A227),
                onPressed:
                    _performSearch,
              ),
              filled: true,
              fillColor: Colors.white,
              contentPadding:
                  const EdgeInsets.symmetric(
                horizontal: 12,
                vertical: 4,
              ),
              border: OutlineInputBorder(
                borderRadius:
                    BorderRadius.circular(14),
                borderSide:
                    BorderSide.none,
              ),
            ),
          ),
          const SizedBox(height: 8),
          Row(
            children: [
              Expanded(
                child: _modeButton(
                  'সূরা',
                  QuranSearchMode.surah,
                ),
              ),
              const SizedBox(width: 8),
              Expanded(
                child: _modeButton(
                  'আয়াত',
                  QuranSearchMode.ayah,
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _modeButton(
    String text,
    QuranSearchMode mode,
  ) {
    final selected = _mode == mode;

    return InkWell(
      borderRadius:
          BorderRadius.circular(10),
      onTap: () => _setMode(mode),
      child: Container(
        height: 38,
        alignment: Alignment.center,
        decoration: BoxDecoration(
          color: selected
              ? Colors.white
              : Colors.white.withValues(
                  alpha: 0.18,
                ),
          borderRadius:
              BorderRadius.circular(10),
          border: Border.all(
            color: Colors.white.withValues(
              alpha: 0.35,
            ),
          ),
        ),
        child: Text(
          text,
          style: TextStyle(
            color: selected
                ? const Color(0xFF0A8754)
                : Colors.white,
            fontWeight: FontWeight.bold,
          ),
        ),
      ),
    );
  }

  Widget _searchResults() {
    return AnimatedBuilder(
      animation: _searchController,
      builder: (context, _) {
        if (!_searching) {
          return const SizedBox.shrink();
        }

        if (_searchController.isLoading) {
          return const Center(
            child:
                CircularProgressIndicator(),
          );
        }

        if (_searchController.error !=
            null) {
          return const Center(
            child: Text(
              'কুরআনের তথ্য লোড করা যায়নি।',
            ),
          );
        }

        final surahs =
            _searchController.surahs;

        if (surahs.isEmpty) {
          return const Center(
            child: Text(
              'কোনো সূরা পাওয়া যায়নি।',
              style: TextStyle(
                fontSize: 16,
                fontWeight:
                    FontWeight.w600,
              ),
            ),
          );
        }

        return ListView.builder(
          padding:
              const EdgeInsets.all(12),
          itemCount: surahs.length,
          itemBuilder: (context, index) {
            final surah = surahs[index];

            return Card(
              child: ListTile(
                leading: CircleAvatar(
                  backgroundColor:
                      const Color(0xFF0A8754),
                  child: Text(
                    '${surah.id}',
                    style:
                        const TextStyle(
                      color: Colors.white,
                      fontWeight:
                          FontWeight.bold,
                    ),
                  ),
                ),
                title: Text(
                  surah.banglaName,
                  style:
                      const TextStyle(
                    fontWeight:
                        FontWeight.bold,
                  ),
                ),
                subtitle: Text(
                  '${surah.arabicName} • ${surah.englishName} • ${surah.totalAyah} আয়াত',
                ),
                trailing:
                    const Icon(
                  Icons
                      .arrow_forward_ios_rounded,
                  size: 16,
                ),
                onTap: () {
                  Navigator.push(
                    context,
                    MaterialPageRoute(
                      builder: (_) =>
                          SurahDetailPage(
                        surah: surah,
                      ),
                    ),
                  );
                },
              ),
            );
          },
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    return DefaultTabController(
      length: 3,
      child: Scaffold(
        appBar: AppBar(
          title: const Text(
            'আল-কুরআন',
            style: TextStyle(
              fontWeight: FontWeight.bold,
            ),
          ),
          bottom:
              const PreferredSize(
            preferredSize:
                Size.fromHeight(118),
            child: SizedBox.shrink(),
          ),
          flexibleSpace:
              SafeArea(
            child: Column(
              children: [
                const SizedBox(height: 48),
                _searchSection(),
              ],
            ),
          ),
        ),
        body: _searching
            ? _searchResults()
            : Column(
                children: [
                  _lastReadBanner(),
                  const Expanded(
                    child: TabBarView(
                      children: [
                        SurahListPage(),
                        JuzPage(),
                        BookmarkPage(),
                      ],
                    ),
                  ),
                ],
              ),
      ),
    );
  }
}
