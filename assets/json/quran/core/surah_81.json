{
  "surahNumber": 81,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 29,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "إِذَا ٱلشَّمۡسُ كُوِّرَتۡ",
      "banglaText": "যখন সূর্য আলোহীন হয়ে যাবে",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ",
      "banglaText": "যখন নক্ষত্র মলিন হয়ে যাবে",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ",
      "banglaText": "যখন পর্বতমালা অপসারিত হবে",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ",
      "banglaText": "যখন দশ মাসের গর্ভবতী উষ্ট্রীসমূহ উপেক্ষিত হবে",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ",
      "banglaText": "যখন বন্য পশুরা একত্রিত হয়ে যাবে",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ",
      "banglaText": "যখন সমুদ্রকে উত্তাল করে তোলা হবে",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ",
      "banglaText": "যখন আত্মাসমূহকে যুগল করা হবে",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ",
      "banglaText": "যখন জীবন্ত প্রোথিত কন্যাকে জিজ্ঞেস করা হবে",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "بِأَيِّ ذَنۢبٖ قُتِلَتۡ",
      "banglaText": "কি অপরাধে তাকে হত্য করা হল",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "وَإِذَا ٱلصُّحُفُ نُشِرَتۡ",
      "banglaText": "যখন আমলনামা খোলা হবে",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ",
      "banglaText": "যখন আকাশের আবরণ অপসারিত হবে",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ",
      "banglaText": "যখন জাহান্নামের অগ্নি প্রজ্বলিত করা হবে",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ",
      "banglaText": "এবং যখন জান্নাত সন্নিকটবর্তী হবে",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ",
      "banglaText": "তখন প্রত্যেকেই জেনে নিবে সে কি উপস্থিত করেছে।",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ",
      "banglaText": "আমি শপথ করি যেসব নক্ষত্রগুলো পশ্চাতে সরে যায়।",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "ٱلۡجَوَارِ ٱلۡكُنَّسِ",
      "banglaText": "চলমান হয় ও অদৃশ্য হয়",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "وَٱلَّيۡلِ إِذَا عَسۡعَسَ",
      "banglaText": "শপথ নিশাবসান ও",
      "englishText": ""
    },
    {
      "number": 18,
      "arabicText": "وَٱلصُّبۡحِ إِذَا تَنَفَّسَ",
      "banglaText": "প্রভাত আগমন কালের",
      "englishText": ""
    },
    {
      "number": 19,
      "arabicText": "إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ",
      "banglaText": "নিশ্চয় কোরআন সম্মানিত রসূলের আনীত বাণী",
      "englishText": ""
    },
    {
      "number": 20,
      "arabicText": "ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ",
      "banglaText": "যিনি শক্তিশালী, আরশের মালিকের নিকট মর্যাদাশালী",
      "englishText": ""
    },
    {
      "number": 21,
      "arabicText": "مُّطَاعٖ ثَمَّ أَمِينٖ",
      "banglaText": "সবার মান্যবর, সেখানকার বিশ্বাসভাজন।",
      "englishText": ""
    },
    {
      "number": 22,
      "arabicText": "وَمَا صَاحِبُكُم بِمَجۡنُونٖ",
      "banglaText": "এবং তোমাদের সাথী পাগল নন।",
      "englishText": ""
    },
    {
      "number": 23,
      "arabicText": "وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ",
      "banglaText": "তিনি সেই ফেরেশতাকে প্রকাশ্য দিগন্তে দেখেছেন।",
      "englishText": ""
    },
    {
      "number": 24,
      "arabicText": "وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ",
      "banglaText": "তিনি অদৃশ্য বিষয় বলতে কৃপনতা করেন না।",
      "englishText": ""
    },
    {
      "number": 25,
      "arabicText": "وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ",
      "banglaText": "এটা বিতাড়িত শয়তানের উক্তি নয়।",
      "englishText": ""
    },
    {
      "number": 26,
      "arabicText": "فَأَيۡنَ تَذۡهَبُونَ",
      "banglaText": "অতএব, তোমরা কোথায় যাচ্ছ",
      "englishText": ""
    },
    {
      "number": 27,
      "arabicText": "إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ",
      "banglaText": "এটা তো কেবল বিশ্বাবাসীদের জন্যে উপদেশ",
      "englishText": ""
    },
    {
      "number": 28,
      "arabicText": "لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ",
      "banglaText": "তার জন্যে, যে তোমাদের মধ্যে সোজা চলতে চায়।",
      "englishText": ""
    },
    {
      "number": 29,
      "arabicText": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",
      "banglaText": "তোমরা আল্লাহ রাব্বুল আলামীনের অভিপ্রায়ের বাইরে অন্য কিছুই ইচ্ছা করতে পার না।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}