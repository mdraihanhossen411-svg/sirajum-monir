  "totalAyah": 11,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا",
      "banglaText": "শপথ উর্ধ্বশ্বাসে চলমান অশ্বসমূহের",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "فَٱلۡمُورِيَٰتِ قَدۡحٗا",
      "banglaText": "অতঃপর ক্ষুরাঘাতে অগ্নিবিচ্ছুরক অশ্বসমূহের",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "فَٱلۡمُغِيرَٰتِ صُبۡحٗا",
      "banglaText": "অতঃপর প্রভাতকালে আক্রমণকারী অশ্বসমূহের",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "فَأَثَرۡنَ بِهِۦ نَقۡعٗا",
      "banglaText": "ও যারা সে সময়ে ধুলি উৎক্ষিপ্ত করে",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "فَوَسَطۡنَ بِهِۦ جَمۡعًا",
      "banglaText": "অতঃপর যারা শক্রদলের অভ্যন্তরে ঢুকে পড়ে",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ",
      "banglaText": "নিশ্চয় মানুষ তার পালনকর্তার প্রতি অকৃতজ্ঞ।",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ",
      "banglaText": "এবং সে অবশ্য এ বিষয়ে অবহিত",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ",
      "banglaText": "এবং সে নিশ্চিতই ধন-সম্পদের ভালবাসায় মত্ত।",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ",
      "banglaText": "সে কি জানে না, যখন কবরে যা আছে, তা উত্থিত হবে",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "وَحُصِّلَ مَا فِي ٱلصُّدُورِ",
      "banglaText": "এবং অন্তরে যা আছে, তা অর্জন করা হবে",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ",
      "banglaText": "সেদিন তাদের কি হবে, সে সম্পর্কে তাদের পালনকর্তা সবিশেষ জ্ঞাত।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}