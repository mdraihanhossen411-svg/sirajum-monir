  "totalAyah": 8,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "وَٱلتِّينِ وَٱلزَّيۡتُونِ",
      "banglaText": "শপথ আঞ্জীর (ডুমুর) ও যয়তুনের",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "وَطُورِ سِينِينَ",
      "banglaText": "এবং সিনাই প্রান্তরস্থ তূর পর্বতের",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ",
      "banglaText": "এবং এই নিরাপদ নগরীর।",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ",
      "banglaText": "আমি সৃষ্টি করেছি মানুষকে সুন্দরতর অবয়বে।",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ",
      "banglaText": "অতঃপর তাকে ফিরিয়ে দিয়েছি নীচ থেকে নীচে।",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ",
      "banglaText": "কিন্তু যারা বিশ্বাস স্থাপন করেছে ও সৎকর্ম করেছে, তাদের জন্যে রয়েছে অশেষ পুরস্কার।",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ",
      "banglaText": "অতঃপর কেন তুমি অবিশ্বাস করছ কেয়ামতকে",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ",
      "banglaText": "আল্লাহ কি বিচারকদের মধ্যে শ্রেষ্টতম বিচারক নন",
      "englishText": ""
    }
  ],
  "banglaName": ""
}