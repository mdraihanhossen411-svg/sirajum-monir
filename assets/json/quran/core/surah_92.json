{
  "surahNumber": 92,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 21,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "وَٱلَّيۡلِ إِذَا يَغۡشَىٰ",
      "banglaText": "শপথ রাত্রির, যখন সে আচ্ছন্ন করে",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "banglaText": "শপথ দিনের, যখন সে আলোকিত হয়",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ",
      "banglaText": "এবং তাঁর, যিনি নর ও নারী সৃষ্টি করেছেন",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ",
      "banglaText": "নিশ্চয় তোমাদের কর্ম প্রচেষ্টা বিভিন্ন ধরনের।",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ",
      "banglaText": "অতএব, যে দান করে এবং খোদাভীরু হয়",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "وَصَدَّقَ بِٱلۡحُسۡنَىٰ",
      "banglaText": "এবং উত্তম বিষয়কে সত্য মনে করে",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ",
      "banglaText": "আমি তাকে সুখের বিষয়ের জন্যে সহজ পথ দান করব।",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ",
      "banglaText": "আর যে কৃপণতা করে ও বেপরওয়া হয়",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "وَكَذَّبَ بِٱلۡحُسۡنَىٰ",
      "banglaText": "এবং উত্তম বিষয়কে মিথ্যা মনে করে",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ",
      "banglaText": "আমি তাকে কষ্টের বিষয়ের জন্যে সহজ পথ দান করব।",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "banglaText": "যখন সে অধঃপতিত হবে, তখন তার সম্পদ তার কোনই কাজে আসবে না।",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "إِنَّ عَلَيۡنَا لَلۡهُدَىٰ",
      "banglaText": "আমার দায়িত্ব পথ প্রদর্শন করা।",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ",
      "banglaText": "আর আমি মালিক ইহকালের ও পরকালের।",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ",
      "banglaText": "অতএব, আমি তোমাদেরকে প্রজ্বলিত অগ্নি সম্পর্কে সতর্ক করে দিয়েছি।",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى",
      "banglaText": "এতে নিতান্ত হতভাগ্য ব্যক্তিই প্রবেশ করবে",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ",
      "banglaText": "যে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى",
      "banglaText": "এ থেকে দূরে রাখা হবে খোদাভীরু ব্যক্তিকে",
      "englishText": ""
    },
    {
      "number": 18,
      "arabicText": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ",
      "banglaText": "যে আত্নশুদ্ধির জন্যে তার ধন-সম্পদ দান করে।",
      "englishText": ""
    },
    {
      "number": 19,
      "arabicText": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ",
      "banglaText": "এবং তার উপর কারও কোন প্রতিদানযোগ্য অনুগ্রহ থাকে না।",
      "englishText": ""
    },
    {
      "number": 20,
      "arabicText": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ",
      "banglaText": "তার মহান পালনকর্তার সন্তুষ্টি অন্বেষণ ব্যতীত।",
      "englishText": ""
    },
    {
      "number": 21,
      "arabicText": "وَلَسَوۡفَ يَرۡضَىٰ",
      "banglaText": "সে সত্বরই সন্তুষ্টি লাভ করবে।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}