{
  "surahNumber": 82,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 19,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ",
      "banglaText": "যখন আকাশ বিদীর্ণ হবে",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ",
      "banglaText": "যখন নক্ষত্রসমূহ ঝরে পড়বে",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ",
      "banglaText": "যখন সমুদ্রকে উত্তাল করে তোলা হবে",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ",
      "banglaText": "এবং যখন কবরসমূহ উম্মোচিত হবে",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ",
      "banglaText": "তখন প্রত্যেকে জেনে নিবে সে কি অগ্রে প্রেরণ করেছে এবং কি পশ্চাতে ছেড়ে এসেছে।",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ",
      "banglaText": "হে মানুষ, কিসে তোমাকে তোমার মহামহিম পালনকর্তা সম্পর্কে বিভ্রান্ত করল",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
      "banglaText": "যিনি তোমাকে সৃষ্টি করেছেন, অতঃপর তোমাকে সুবিন্যস্ত করেছেন এবং সুষম করেছেন।",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ",
      "banglaText": "যিনি তোমাকে তাঁর ইচ্ছামত আকৃতিতে গঠন করেছেন।",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ",
      "banglaText": "কখনও বিভ্রান্ত হয়ো না; বরং তোমরা দান-প্রতিদানকে মিথ্যা মনে কর।",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ",
      "banglaText": "অবশ্যই তোমাদের উপর তত্ত্বাবধায়ক নিযুক্ত আছে।",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "كِرَامٗا كَٰتِبِينَ",
      "banglaText": "সম্মানিত আমল লেখকবৃন্দ।",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "يَعۡلَمُونَ مَا تَفۡعَلُونَ",
      "banglaText": "তারা জানে যা তোমরা কর।",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ",
      "banglaText": "সৎকর্মশীলগণ থাকবে জান্নাতে।",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ",
      "banglaText": "এবং দুষ্কর্মীরা থাকবে জাহান্নামে",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ",
      "banglaText": "তারা বিচার দিবসে তথায় প্রবেশ করবে।",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ",
      "banglaText": "তারা সেখান থেকে পৃথক হবে না।",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",
      "banglaText": "আপনি জানেন, বিচার দিবস কি",
      "englishText": ""
    },
    {
      "number": 18,
      "arabicText": "ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",
      "banglaText": "অতঃপর আপনি জানেন, বিচার দিবস কি",
      "englishText": ""
    },
    {
      "number": 19,
      "arabicText": "يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ",
      "banglaText": "যেদিন কেউ কারও কোন উপকার করতে পারবে না এবং সেদিন সব কতৃꦣ2468;্ব হবে আল্লাহর।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}