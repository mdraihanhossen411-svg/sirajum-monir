  "totalAyah": 8,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ",
      "banglaText": "প্রাচুর্যের লালসা তোমাদেরকে গাফেল রাখে",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ",
      "banglaText": "এমনকি, তোমরা কবরস্থানে পৌছে যাও।",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "كَلَّا سَوۡفَ تَعۡلَمُونَ",
      "banglaText": "এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ",
      "banglaText": "অতঃপর এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ",
      "banglaText": "কখনই নয়; যদি তোমরা নিশ্চিত জানতে।",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "لَتَرَوُنَّ ٱلۡجَحِيمَ",
      "banglaText": "তোমরা অবশ্যই জাহান্নাম দেখবে",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ",
      "banglaText": "অতঃপর তোমরা তা অবশ্যই দেখবে দিব্য প্রত্যয়ে",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "banglaText": "এরপর অবশ্যই সেদিন তোমরা নেয়ামত সম্পর্কে জিজ্ঞাসিত হবে।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}