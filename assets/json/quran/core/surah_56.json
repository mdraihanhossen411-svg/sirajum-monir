{
  "surahNumber": 56,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 96,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "إِذَا وَقَعَتِ ٱلۡوَاقِعَةُ",
      "banglaText": "যখন কিয়ামতের ঘটনা ঘটবে",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "لَيۡسَ لِوَقۡعَتِهَا كَاذِبَةٌ",
      "banglaText": "যার বাস্তবতায় কোন সংশয় নেই।",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "خَافِضَةٞ رَّافِعَةٌ",
      "banglaText": "এটা নীচু করে দেবে, সমুন্নত করে দেবে।",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "إِذَا رُجَّتِ ٱلۡأَرۡضُ رَجّٗا",
      "banglaText": "যখন প্রবলভাবে প্রকম্পিত হবে পৃথিবী।",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "وَبُسَّتِ ٱلۡجِبَالُ بَسّٗا",
      "banglaText": "এবং পর্বতমালা ভেঙ্গে চুরমার হয়ে যাবে।",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "فَكَانَتۡ هَبَآءٗ مُّنۢبَثّٗا",
      "banglaText": "অতঃপর তা হয়ে যাবে উৎক্ষিপ্ত ধূলিকণা।",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "وَكُنتُمۡ أَزۡوَٰجٗا ثَلَٰثَةٗ",
      "banglaText": "এবং তোমরা তিনভাবে বিভক্ত হয়ে পড়বে।",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "فَأَصۡحَٰبُ ٱلۡمَيۡمَنَةِ مَآ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ",
      "banglaText": "যারা ডান দিকে, কত ভাগ্যবান তারা।",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "وَأَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ مَآ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ",
      "banglaText": "এবং যারা বামদিকে, কত হতভাগা তারা।",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ",
      "banglaText": "অগ্রবর্তীগণ তো অগ্রবর্তীই।",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "أُوْلَـٰٓئِكَ ٱلۡمُقَرَّبُونَ",
      "banglaText": "তারাই নৈকট্যশীল",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "فِي جَنَّـٰتِ ٱلنَّعِيمِ",
      "banglaText": "অবদানের উদ্যানসমূহে",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ",
      "banglaText": "তারা একদল পূর্ববর্তীদের মধ্য থেকে।",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "وَقَلِيلٞ مِّنَ ٱلۡأٓخِرِينَ",
      "banglaText": "এবং অল্পসংখ্যক পরবর্তীদের মধ্যে থেকে।",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "عَلَىٰ سُرُرٖ مَّوۡضُونَةٖ",
      "banglaText": "স্বর্ণ খচিত সিংহাসন।",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "مُّتَّكِـِٔينَ عَلَيۡهَا مُتَقَٰبِلِينَ",
      "banglaText": "তারা তাতে হেলান দিয়ে বসবে পরস্পর মুখোমুখি হয়ে।",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "يَطُوفُ عَلَيۡهِمۡ وِلۡدَٰنٞ مُّخَلَّدُونَ",
      "banglaText": "তাদের কাছে ঘোরাফেরা করবে চির কিশোরেরা।",
      "englishText": ""
    },
    {
      "number": 18,
      "arabicText": "بِأَكۡوَابٖ وَأَبَارِيقَ وَكَأۡسٖ مِّن مَّعِينٖ",
      "banglaText": "পানপাত্র কুঁজা ও খাঁটি সূরাপূর্ণ পেয়ালা হাতে নিয়ে",
      "englishText": ""
    },
    {
      "number": 19,
      "arabicText": "لَّا يُصَدَّعُونَ عَنۡهَا وَلَا يُنزِفُونَ",
      "banglaText": "যা পান করলে তাদের শিরঃপীড়া হবে না এবং বিকারগ্রস্ত ও হবে না।",
      "englishText": ""
    },
    {
      "number": 20,
      "arabicText": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ",
      "banglaText": "আর তাদের পছন্দমত ফল-মুল নিয়ে",
      "englishText": ""
    },
    {
      "number": 21,
      "arabicText": "وَلَحۡمِ طَيۡرٖ مِّمَّا يَشۡتَهُونَ",
      "banglaText": "এবং রুচিমত পাখীর মাংস নিয়ে।",
      "englishText": ""
    },
    {
      "number": 22,
      "arabicText": "وَحُورٌ عِينٞ",
      "banglaText": "তথায় থাকবে আনতনয়না হুরগণ",
      "englishText": ""
    },
    {
      "number": 23,
      "arabicText": "كَأَمۡثَٰلِ ٱللُّؤۡلُوِٕ ٱلۡمَكۡنُونِ",
      "banglaText": "আবরণে রক্ষিত মোতির ন্যায়",
      "englishText": ""
    },
    {
      "number": 24,
      "arabicText": "جَزَآءَۢ بِمَا كَانُواْ يَعۡمَلُونَ",
      "banglaText": "তারা যা কিছু করত, তার পুরস্কারস্বরূপ।",
      "englishText": ""
    },
    {
      "number": 25,
      "arabicText": "لَا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا تَأۡثِيمًا",
      "banglaText": "তারা তথায় অবান্তর ও কোন খারাপ কথা শুনবে না।",
      "englishText": ""
    },
    {
      "number": 26,
      "arabicText": "إِلَّا قِيلٗا سَلَٰمٗا سَلَٰمٗا",
      "banglaText": "কিন্তু শুনবে সালাম আর সালাম।",
      "englishText": ""
    },
    {
      "number": 27,
      "arabicText": "وَأَصۡحَٰبُ ٱلۡيَمِينِ مَآ أَصۡحَٰبُ ٱلۡيَمِينِ",
      "banglaText": "যারা ডান দিকে থাকবে, তারা কত ভাগ্যবান।",
      "englishText": ""
    },
    {
      "number": 28,
      "arabicText": "فِي سِدۡرٖ مَّخۡضُودٖ",
      "banglaText": "তারা থাকবে কাঁটাবিহীন বদরিকা বৃক্ষে।",
      "englishText": ""
    },
    {
      "number": 29,
      "arabicText": "وَطَلۡحٖ مَّنضُودٖ",
      "banglaText": "এবং কাঁদি কাঁদি কলায়",
      "englishText": ""
    },
    {
      "number": 30,
      "arabicText": "وَظِلّٖ مَّمۡدُودٖ",
      "banglaText": "এবং দীর্ঘ ছায়ায়।",
      "englishText": ""
    },
    {
      "number": 31,
      "arabicText": "وَمَآءٖ مَّسۡكُوبٖ",
      "banglaText": "এবং প্রবাহিত পানিতে",
      "englishText": ""
    },
    {
      "number": 32,
      "arabicText": "وَفَٰكِهَةٖ كَثِيرَةٖ",
      "banglaText": "ও প্রচুর ফল-মূলে",
      "englishText": ""
    },
    {
      "number": 33,
      "arabicText": "لَّا مَقۡطُوعَةٖ وَلَا مَمۡنُوعَةٖ",
      "banglaText": "যা শেষ হবার নয় এবং নিষিদ্ধ ও নয়",
      "englishText": ""
    },
    {
      "number": 34,
      "arabicText": "وَفُرُشٖ مَّرۡفُوعَةٍ",
      "banglaText": "আর থাকবে সমুন্নত শয্যায়।",
      "englishText": ""
    },
    {
      "number": 35,
      "arabicText": "إِنَّآ أَنشَأۡنَٰهُنَّ إِنشَآءٗ",
      "banglaText": "আমি জান্নাতী রমণীগণকে বিশেষরূপে সৃষ্টি করেছি।",
      "englishText": ""
    },
    {
      "number": 36,
      "arabicText": "فَجَعَلۡنَٰهُنَّ أَبۡكَارًا",
      "banglaText": "অতঃপর তাদেরকে করেছি চিরকুমারী।",
      "englishText": ""
    },
    {
      "number": 37,
      "arabicText": "عُرُبًا أَتۡرَابٗا",
      "banglaText": "কামিনী, সমবয়স্কা।",
      "englishText": ""
    },
    {
      "number": 38,
      "arabicText": "لِّأَصۡحَٰبِ ٱلۡيَمِينِ",
      "banglaText": "ডান দিকের লোকদের জন্যে।",
      "englishText": ""
    },
    {
      "number": 39,
      "arabicText": "ثُلَّةٞ مِّنَ ٱلۡأَوَّلِينَ",
      "banglaText": "তাদের একদল হবে পূর্ববর্তীদের মধ্য থেকে।",
      "englishText": ""
    },
    {
      "number": 40,
      "arabicText": "وَثُلَّةٞ مِّنَ ٱلۡأٓخِرِينَ",
      "banglaText": "এবং একদল পরবর্তীদের মধ্য থেকে।",
      "englishText": ""
    },
    {
      "number": 41,
      "arabicText": "وَأَصۡحَٰبُ ٱلشِّمَالِ مَآ أَصۡحَٰبُ ٱلشِّمَالِ",
      "banglaText": "বামপার্শ্বস্থ লোক, কত না হতভাগা তারা।",
      "englishText": ""
    },
    {
      "number": 42,
      "arabicText": "فِي سَمُومٖ وَحَمِيمٖ",
      "banglaText": "তারা থাকবে প্রখর বাষ্পে এবং উত্তপ্ত পানিতে",
      "englishText": ""
    },
    {
      "number": 43,
      "arabicText": "وَظِلّٖ مِّن يَحۡمُومٖ",
      "banglaText": "এবং ধুম্রকুঞ্জের ছায়ায়।",
      "englishText": ""
    },
    {
      "number": 44,
      "arabicText": "لَّا بَارِدٖ وَلَا كَرِيمٍ",
      "banglaText": "যা শীতল নয় এবং আরামদায়কও নয়।",
      "englishText": ""
    },
    {
      "number": 45,
      "arabicText": "إِنَّهُمۡ كَانُواْ قَبۡلَ ذَٰلِكَ مُتۡرَفِينَ",
      "banglaText": "তারা ইতিপূর্বে স্বাচ্ছন্দ্যশীল ছিল।",
      "englishText": ""
    },
    {
      "number": 46,
      "arabicText": "وَكَانُواْ يُصِرُّونَ عَلَى ٱلۡحِنثِ ٱلۡعَظِيمِ",
      "banglaText": "তারা সদাসর্বদা ঘোরতর পাপকর্মে ডুবে থাকত।",
      "englishText": ""
    },
    {
      "number": 47,
      "arabicText": "وَكَانُواْ يَقُولُونَ أَئِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ",
      "banglaText": "তারা বলতঃ আমরা যখন মরে অস্থি ও মৃত্তিকায় পরিণত হয়ে যাব, তখনও কি পুনরুত্থিত হব",
      "englishText": ""
    },
    {
      "number": 48,
      "arabicText": "أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ",
      "banglaText": "এবং আমাদের পূর্বপুরুষগণও",
      "englishText": ""
    },
    {
      "number": 49,
      "arabicText": "قُلۡ إِنَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ",
      "banglaText": "বলুনঃ পূর্ববর্তী ও পরবর্তীগণ",
      "englishText": ""
    },
    {
      "number": 50,
      "arabicText": "لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ",
      "banglaText": "সবাই একত্রিত হবে এক নির্দিষ্ট দিনের নির্দিষ্ট সময়ে।",
      "englishText": ""
    },
    {
      "number": 51,
      "arabicText": "ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ",
      "banglaText": "অতঃপর হে পথভ্রষ্ট, মিথ্যারোপকারীগণ।",
      "englishText": ""
    },
    {
      "number": 52,
      "arabicText": "لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ",
      "banglaText": "তোমরা অবশ্যই ভক্ষণ করবে যাক্কুম বৃক্ষ থেকে",
      "englishText": ""
    },
    {
      "number": 53,
      "arabicText": "فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",
      "banglaText": "অতঃপর তা দ্বারা উদর পূর্ণ করবে",
      "englishText": ""
    },
    {
      "number": 54,
      "arabicText": "فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ",
      "banglaText": "অতঃপর তার উপর পান করবে উত্তপ্ত পানি।",
      "englishText": ""
    },
    {
      "number": 55,
      "arabicText": "فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ",
      "banglaText": "পান করবে পিপাসিত উটের ন্যায়।",
      "englishText": ""
    },
    {
      "number": 56,
      "arabicText": "هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ",
      "banglaText": "কেয়ামতের দিন এটাই হবে তাদের আপ্যায়ন।",
      "englishText": ""
    },
    {
      "number": 57,
      "arabicText": "نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ",
      "banglaText": "আমি সৃষ্টি করেছি তোমাদেরকে। অতঃপর কেন তোমরা তা সত্য বলে বিশ্বাস কর না।",
      "englishText": ""
    },
    {
      "number": 58,
      "arabicText": "أَفَرَءَيۡتُم مَّا تُمۡنُونَ",
      "banglaText": "তোমরা কি ভেবে দেখেছ, তোমাদের বীর্যপাত সম্পর্কে।",
      "englishText": ""
    },
    {
      "number": 59,
      "arabicText": "ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ",
      "banglaText": "তোমরা তাকে সৃষ্টি কর, না আমি সৃষ্টি করি",
      "englishText": ""
    },
    {
      "number": 60,
      "arabicText": "نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ",
      "banglaText": "আমি তোমাদের মৃত্যুকাল নির্ধারিত করেছি এবং আমি অক্ষম নই।",
      "englishText": ""
    },
    {
      "number": 61,
      "arabicText": "عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ",
      "banglaText": "এ ব্যাপারে যে, তোমাদের পরিবর্তে তোমাদের মত লোককে নিয়ে আসি এবং তোমাদেরকে এমন করে দেই, যা তোমরা জান না।",
      "englishText": ""
    },
    {
      "number": 62,
      "arabicText": "وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ",
      "banglaText": "তোমরা অবগত হয়েছ প্রথম সৃষ্টি সম্পর্কে, তবে তোমরা অনুধাবন কর না কেন",
      "englishText": ""
    },
    {
      "number": 63,
      "arabicText": "أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ",
      "banglaText": "তোমরা যে বীজ বপন কর, সে সম্পর্কে ভেবে দেখেছ কি",
      "englishText": ""
    },
    {
      "number": 64,
      "arabicText": "ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّـٰرِعُونَ",
      "banglaText": "তোমরা তাকে উৎপন্ন কর, না আমি উৎপন্নকারী",
      "englishText": ""
    },
    {
      "number": 65,
      "arabicText": "لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ",
      "banglaText": "আমি ইচ্ছা করলে তাকে খড়কুটা করে দিতে পারি, অতঃপর হয়ে যাবে তোমরা বিস্ময়াবিষ্ট।",
      "englishText": ""
    },
    {
      "number": 66,
      "arabicText": "إِنَّا لَمُغۡرَمُونَ",
      "banglaText": "বলবেঃ আমরা তো ঋণের চাপে পড়ে গেলাম",
      "englishText": ""
    },
    {
      "number": 67,
      "arabicText": "بَلۡ نَحۡنُ مَحۡرُومُونَ",
      "banglaText": "বরং আমরা হূত সর্বস্ব হয়ে পড়লাম।",
      "englishText": ""
    },
    {
      "number": 68,
      "arabicText": "أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ",
      "banglaText": "তোমরা যে পানি পান কর, সে সম্পর্কে ভেবে দেখেছ কি",
      "englishText": ""
    },
    {
      "number": 69,
      "arabicText": "ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ",
      "banglaText": "তোমরা তা মেঘ থেকে নামিয়ে আন, না আমি বর্ষন করি",
      "englishText": ""
    },
    {
      "number": 70,
      "arabicText": "لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ",
      "banglaText": "আমি ইচ্ছা করলে তাকে লোনা করে দিতে পারি, অতঃপর তোমরা কেন কৃতজ্ঞতা প্রকাশ কর না",
      "englishText": ""
    },
    {
      "number": 71,
      "arabicText": "أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ",
      "banglaText": "তোমরা যে অগ্নি প্রজ্জ্বলিত কর, সে সম্পর্কে ভেবে দেখেছ কি",
      "englishText": ""
    },
    {
      "number": 72,
      "arabicText": "ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ",
      "banglaText": "তোমরা কি এর বৃক্ষ সৃষ্টি করেছ, না আমি সৃষ্টি করেছি",
      "englishText": ""
    },
    {
      "number": 73,
      "arabicText": "نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ",
      "banglaText": "আমি সেই বৃক্ষকে করেছি স্মরণিকা এবং মরুবাসীদের জন্য সামগ্রী।",
      "englishText": ""
    },
    {
      "number": 74,
      "arabicText": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",
      "banglaText": "অতএব, আপনি আপনার মহান পালনকর্তার নামে পবিত্রতা ঘোষণা করুন।",
      "englishText": ""
    },
    {
      "number": 75,
      "arabicText": "۞فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
      "banglaText": "অতএব, আমি তারকারাজির অস্তাচলের শপথ করছি",
      "englishText": ""
    },
    {
      "number": 76,
      "arabicText": "وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ",
      "banglaText": "নিশ্চয় এটা এক মহা শপথ-যদি তোমরা জানতে।",
      "englishText": ""
    },
    {
      "number": 77,
      "arabicText": "إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ",
      "banglaText": "নিশ্চয় এটা সম্মানিত কোরআন",
      "englishText": ""
    },
    {
      "number": 78,
      "arabicText": "فِي كِتَٰبٖ مَّكۡنُونٖ",
      "banglaText": "যা আছে এক গোপন কিতাবে",
      "englishText": ""
    },
    {
      "number": 79,
      "arabicText": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ",
      "banglaText": "যারা পাক-পবিত্র, তারা ব্যতীত অন্য কেউ একে স্পর্শ করবে না।",
      "englishText": ""
    },
    {
      "number": 80,
      "arabicText": "تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ",
      "banglaText": "এটা বিশ্ব-পালনকর্তার পক্ষ থেকে অবতীর্ণ।",
      "englishText": ""
    },
    {
      "number": 81,
      "arabicText": "أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ",
      "banglaText": "তবুও কি তোমরা এই বাণীর প্রতি শৈথিল্য পদর্শন করবে",
      "englishText": ""
    },
    {
      "number": 82,
      "arabicText": "وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ",
      "banglaText": "এবং একে মিথ্যা বলাকেই তোমরা তোমাদের ভূমিকায় পরিণত করবে",
      "englishText": ""
    },
    {
      "number": 83,
      "arabicText": "فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ",
      "banglaText": "অতঃপর যখন কারও প্রাণ কন্ঠাগত হয়।",
      "englishText": ""
    },
    {
      "number": 84,
      "arabicText": "وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ",
      "banglaText": "এবং তোমরা তাকিয়ে থাক",
      "englishText": ""
    },
    {
      "number": 85,
      "arabicText": "وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ",
      "banglaText": "তখন আমি তোমাদের অপেক্ষা তার অধিক নিকটে থাকি; কিন্তু তোমরা দেখ না।",
      "englishText": ""
    },
    {
      "number": 86,
      "arabicText": "فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ",
      "banglaText": "যদি তোমাদের হিসাব-কিতাব না হওয়াই ঠিক হয়",
      "englishText": ""
    },
    {
      "number": 87,
      "arabicText": "تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ",
      "banglaText": "তবে তোমরা এই আত্মাকে ফিরাও না কেন, যদি তোমরা সত্যবাদী হও",
      "englishText": ""
    },
    {
      "number": 88,
      "arabicText": "فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ",
      "banglaText": "যদি সে নৈকট্যশীলদের একজন হয়",
      "englishText": ""
    },
    {
      "number": 89,
      "arabicText": "فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ",
      "banglaText": "তবে তার জন্যে আছে সুখ, উত্তম রিযিক এবং নেয়ামতে ভরা উদ্যান।",
      "englishText": ""
    },
    {
      "number": 90,
      "arabicText": "وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ",
      "banglaText": "আর যদি সে ডান পার্শ্বস্থদের একজন হয়",
      "englishText": ""
    },
    {
      "number": 91,
      "arabicText": "فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ",
      "banglaText": "তবে তাকে বলা হবেঃ তোমার জন্যে ডানপার্শ্বসস্থদের পক্ষ থেকে সালাম।",
      "englishText": ""
    },
    {
      "number": 92,
      "arabicText": "وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ",
      "banglaText": "আর যদি সে পথভ্রষ্ট মিথ্যারোপকারীদের একজন হয়",
      "englishText": ""
    },
    {
      "number": 93,
      "arabicText": "فَنُزُلٞ مِّنۡ حَمِيمٖ",
      "banglaText": "তবে তার আপ্যায়ন হবে উত্তপ্ত পানি দ্বারা।",
      "englishText": ""
    },
    {
      "number": 94,
      "arabicText": "وَتَصۡلِيَةُ جَحِيمٍ",
      "banglaText": "এবং সে নিক্ষিপ্ত হবে অগ্নিতে।",
      "englishText": ""
    },
    {
      "number": 95,
      "arabicText": "إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ",
      "banglaText": "এটা ধ্রুব সত্য।",
      "englishText": ""
    },
    {
      "number": 96,
      "arabicText": "فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",
      "banglaText": "অতএব, আপনি আপনার মহান পালনকর্তার নামে পবিত্রতা ঘোষণা করুন।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}