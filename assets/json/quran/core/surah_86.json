{
  "surahNumber": 86,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 17,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "banglaText": "শপথ আকাশের এবং রাত্রিতে আগমনকারীর।",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ",
      "banglaText": "আপনি জানেন, যে রাত্রিতে আসে সেটা কি",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "ٱلنَّجۡمُ ٱلثَّاقِبُ",
      "banglaText": "সেটা এক উজ্জ্বল নক্ষত্র।",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ",
      "banglaText": "প্রত্যেকের উপর একজন তত্ত্বাবধায়ক রয়েছে।",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ",
      "banglaText": "অতএব, মানুষের দেখা উচিত কি বস্তু থেকে সে সৃজিত হয়েছে।",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "خُلِقَ مِن مَّآءٖ دَافِقٖ",
      "banglaText": "সে সৃজিত হয়েছে সবেগে স্খলিত পানি থেকে।",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ",
      "banglaText": "এটা নির্গত হয় মেরুদন্ড ও বক্ষপাজরের মধ্য থেকে।",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ",
      "banglaText": "নিশ্চয় তিনি তাকে ফিরিয়ে নিতে সক্ষম।",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ",
      "banglaText": "যেদিন গোপন বিষয়াদি পরীক্ষিত হবে",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ",
      "banglaText": "সেদিন তার কোন শক্তি থাকবে না এবং সাহায্যকারীও থাকবে না।",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ",
      "banglaText": "শপথ চক্রশীল আকাশের",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ",
      "banglaText": "এবং বিদারনশীল পৃথিবীর",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ",
      "banglaText": "নিশ্চয় কোরআন সত্য-মিথ্যার ফয়সালা।",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "وَمَا هُوَ بِٱلۡهَزۡلِ",
      "banglaText": "এবং এটা উপহাস নয়।",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا",
      "banglaText": "তারা ভীষণ চক্রান্ত করে",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "وَأَكِيدُ كَيۡدٗا",
      "banglaText": "আর আমিও কৌশল করি।",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا",
      "banglaText": "অতএব, কাফেরদেরকে অবকাশ দিন, তাদেরকে অবকাশ দিন, কিছু দিনের জন্যে।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}