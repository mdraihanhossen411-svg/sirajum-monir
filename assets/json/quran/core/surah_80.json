{
  "surahNumber": 80,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 42,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "عَبَسَ وَتَوَلَّىٰٓ",
      "banglaText": "তিনি ভ্রূকুঞ্চিত করলেন এবং মুখ ফিরিয়ে নিলেন।",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "أَن جَآءَهُ ٱلۡأَعۡمَىٰ",
      "banglaText": "কারণ, তাঁর কাছে এক অন্ধ আগমন করল।",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "banglaText": "আপনি কি জানেন, সে হয়তো পরিশুদ্ধ হত",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ",
      "banglaText": "অথবা উপদেশ গ্রহণ করতো এবং উপদেশ তার উপকার হত।",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "أَمَّا مَنِ ٱسۡتَغۡنَىٰ",
      "banglaText": "পরন্তু যে বেপরোয়া",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "banglaText": "আপনি তার চিন্তায় মশগুল।",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ",
      "banglaText": "সে শুদ্ধ না হলে আপনার কোন দোষ নেই।",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ",
      "banglaText": "যে আপনার কাছে দৌড়ে আসলো",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "وَهُوَ يَخۡشَىٰ",
      "banglaText": "এমতাবস্থায় যে, সে ভয় করে",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "فَأَنتَ عَنۡهُ تَلَهَّىٰ",
      "banglaText": "আপনি তাকে অবজ্ঞা করলেন।",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "كَلَّآ إِنَّهَا تَذۡكِرَةٞ",
      "banglaText": "কখনও এরূপ করবেন না, এটা উপদেশবানী।",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "فَمَن شَآءَ ذَكَرَهُۥ",
      "banglaText": "অতএব, যে ইচ্ছা করবে, সে একে গ্রহণ করবে।",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "فِي صُحُفٖ مُّكَرَّمَةٖ",
      "banglaText": "এটা লিখিত আছে সম্মানিত",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ",
      "banglaText": "উচ্চ পবিত্র পত্রসমূহে",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "بِأَيۡدِي سَفَرَةٖ",
      "banglaText": "লিপিকারের হস্তে",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "كِرَامِۭ بَرَرَةٖ",
      "banglaText": "যারা মহৎ, পূত চরিত্র।",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ",
      "banglaText": "মানুষ ধ্বংস হোক, সে কত অকৃতজ্ঞ",
      "englishText": ""
    },
    {
      "number": 18,
      "arabicText": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ",
      "banglaText": "তিনি তাকে কি বস্তু থেকে সৃষ্টি করেছেন",
      "englishText": ""
    },
    {
      "number": 19,
      "arabicText": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "banglaText": "শুক্র থেকে তাকে সৃষ্টি করেছেন, অতঃপর তাকে সুপরিমিত করেছেন।",
      "englishText": ""
    },
    {
      "number": 20,
      "arabicText": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "banglaText": "অতঃপর তার পথ সহজ করেছেন",
      "englishText": ""
    },
    {
      "number": 21,
      "arabicText": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ",
      "banglaText": "অতঃপর তার মৃত্যু ঘটান ও কবরস্থ করেন তাকে।",
      "englishText": ""
    },
    {
      "number": 22,
      "arabicText": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "banglaText": "এরপর যখন ইচ্ছা করবেন তখন তাকে পুনরুজ্জীবিত করবেন।",
      "englishText": ""
    },
    {
      "number": 23,
      "arabicText": "كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ",
      "banglaText": "সে কখনও কৃতজ্ঞ হয়নি, তিনি তাকে যা আদেশ করেছেন, সে তা পূর্ণ করেনি।",
      "englishText": ""
    },
    {
      "number": 24,
      "arabicText": "فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "banglaText": "মানুষ তার খাদ্যের প্রতি লক্ষ্য করুক",
      "englishText": ""
    },
    {
      "number": 25,
      "arabicText": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا",
      "banglaText": "আমি আশ্চর্য উপায়ে পানি বর্ষণ করেছি",
      "englishText": ""
    },
    {
      "number": 26,
      "arabicText": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا",
      "banglaText": "এরপর আমি ভূমিকে বিদীর্ণ করেছি",
      "englishText": ""
    },
    {
      "number": 27,
      "arabicText": "فَأَنۢبَتۡنَا فِيهَا حَبّٗا",
      "banglaText": "অতঃপর তাতে উৎপন্ন করেছি শস্য",
      "englishText": ""
    },
    {
      "number": 28,
      "arabicText": "وَعِنَبٗا وَقَضۡبٗا",
      "banglaText": "আঙ্গুর, শাক-সব্জি",
      "englishText": ""
    },
    {
      "number": 29,
      "arabicText": "وَزَيۡتُونٗا وَنَخۡلٗا",
      "banglaText": "যয়তুন, খর্জূর",
      "englishText": ""
    },
    {
      "number": 30,
      "arabicText": "وَحَدَآئِقَ غُلۡبٗا",
      "banglaText": "ঘন উদ্যান",
      "englishText": ""
    },
    {
      "number": 31,
      "arabicText": "وَفَٰكِهَةٗ وَأَبّٗا",
      "banglaText": "ফল এবং ঘাস",
      "englishText": ""
    },
    {
      "number": 32,
      "arabicText": "مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ",
      "banglaText": "তোমাদেরও তোমাদের চতুস্পদ জন্তুদের উপাকারার্থে।",
      "englishText": ""
    },
    {
      "number": 33,
      "arabicText": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "banglaText": "অতঃপর যেদিন কর্ণবিদারক নাদ আসবে",
      "englishText": ""
    },
    {
      "number": 34,
      "arabicText": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ",
      "banglaText": "সেদিন পলায়ন করবে মানুষ তার ভ্রাতার কাছ থেকে",
      "englishText": ""
    },
    {
      "number": 35,
      "arabicText": "وَأُمِّهِۦ وَأَبِيهِ",
      "banglaText": "তার মাতা, তার পিতা",
      "englishText": ""
    },
    {
      "number": 36,
      "arabicText": "وَصَٰحِبَتِهِۦ وَبَنِيهِ",
      "banglaText": "তার পত্নী ও তার সন্তানদের কাছ থেকে।",
      "englishText": ""
    },
    {
      "number": 37,
      "arabicText": "لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ",
      "banglaText": "সেদিন প্রত্যেকেরই নিজের এক চিন্তা থাকবে, যা তাকে ব্যতিব্যস্ত করে রাখবে।",
      "englishText": ""
    },
    {
      "number": 38,
      "arabicText": "وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ",
      "banglaText": "অনেক মুখমন্ডল সেদিন হবে উজ্জ্বল",
      "englishText": ""
    },
    {
      "number": 39,
      "arabicText": "ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ",
      "banglaText": "সহাস্য ও প্রফুল্ল।",
      "englishText": ""
    },
    {
      "number": 40,
      "arabicText": "وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ",
      "banglaText": "এবং অনেক মুখমন্ডল সেদিন হবে ধুলি ধূসরিত।",
      "englishText": ""
    },
    {
      "number": 41,
      "arabicText": "تَرۡهَقُهَا قَتَرَةٌ",
      "banglaText": "তাদেরকে কালিমা আচ্ছন্ন করে রাখবে।",
      "englishText": ""
    },
    {
      "number": 42,
      "arabicText": "أُوْلَـٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ",
      "banglaText": "তারাই কাফের পাপিষ্ঠের দল।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}