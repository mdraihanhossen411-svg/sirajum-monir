{
  "surahNumber": 87,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 19,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى",
      "banglaText": "আপনি আপনার মহান পালনকর্তার নামের পবিত্রতা বর্ণনা করুন",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "ٱلَّذِي خَلَقَ فَسَوَّىٰ",
      "banglaText": "যিনি সৃষ্টি করেছেন ও সুবিন্যস্ত করেছেন।",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "وَٱلَّذِي قَدَّرَ فَهَدَىٰ",
      "banglaText": "এবং যিনি সুপরিমিত করেছেন ও পথ প্রদর্শন করেছেন",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ",
      "banglaText": "এবং যিনি তৃণাদি উৎপন্ন করেছেন",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ",
      "banglaText": "অতঃপর করেছেন তাকে কাল আবর্জনা।",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ",
      "banglaText": "আমি আপনাকে পাঠ করাতে থাকব, ফলে আপনি বিস্মৃত হবেন না",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ",
      "banglaText": "আল্লাহ যা ইচ্ছা করেন তা ব্যতীত। নিশ্চয় তিনি জানেন প্রকাশ্য ও গোপন বিষয়।",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ",
      "banglaText": "আমি আপনার জন্যে সহজ শরীয়ত সহজতর করে দেবো।",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ",
      "banglaText": "উপদেশ ফলপ্রসূ হলে উপদেশ দান করুন",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "سَيَذَّكَّرُ مَن يَخۡشَىٰ",
      "banglaText": "যে ভয় করে, সে উপদেশ গ্রহণ করবে",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى",
      "banglaText": "আর যে, হতভাগা, সে তা উপেক্ষা করবে",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ",
      "banglaText": "সে মহা-অগ্নিতে প্রবেশ করবে।",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ",
      "banglaText": "অতঃপর সেখানে সে মরবেও না, জীবিতও থাকবে না।",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ",
      "banglaText": "নিশ্চয় সাফল্য লাভ করবে সে, যে শুদ্ধ হয়",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ",
      "banglaText": "এবং তার পালনকর্তার নাম স্মরণ করে, অতঃপর নামায আদায় করে।",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",
      "banglaText": "বস্তুতঃ তোমরা পার্থিব জীবনকে অগ্রাধিকার দাও",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ",
      "banglaText": "অথচ পরকালের জীবন উৎকৃষ্ট ও স্থায়ী।",
      "englishText": ""
    },
    {
      "number": 18,
      "arabicText": "إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ",
      "banglaText": "এটা লিখিত রয়েছে পূর্ববতী কিতাবসমূহে",
      "englishText": ""
    },
    {
      "number": 19,
      "arabicText": "صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ",
      "banglaText": "ইব্রাহীম ও মূসার কিতাবসমূহে।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}