{
  "surahNumber": 75,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 40,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ",
      "banglaText": "আমি শপথ করি কেয়ামত দিবসের",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ",
      "banglaText": "আরও শপথ করি সেই মনের, যে নিজেকে ধিক্কার দেয়",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ",
      "banglaText": "মানুষ কি মনে করে যে আমি তার অস্থিসমূহ একত্রিত করব না",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ",
      "banglaText": "পরন্ত আমি তার অংগুলিগুলো পর্যন্ত সঠিকভাবে সন্নিবেশিত করতে সক্ষম।",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ",
      "banglaText": "বরং মানুষ তার ভবিষ্যত জীবনেও ধৃষ্টতা করতে চায়",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ",
      "banglaText": "সে প্রশ্ন করে-কেয়ামত দিবস কবে",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "فَإِذَا بَرِقَ ٱلۡبَصَرُ",
      "banglaText": "যখন দৃষ্টি চমকে যাবে",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "وَخَسَفَ ٱلۡقَمَرُ",
      "banglaText": "চন্দ্র জ্যোতিহীন হয়ে যাবে।",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ",
      "banglaText": "এবং সূর্য ও চন্দ্রকে একত্রিত করা হবে",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ",
      "banglaText": "সে দিন মানুষ বলবেঃ পলায়নের জায়গা কোথায়",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "كَلَّا لَا وَزَرَ",
      "banglaText": "না কোথাও আশ্রয়স্থল নেই।",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ",
      "banglaText": "আপনার পালনকর্তার কাছেই সেদিন ঠাঁই হবে।",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "banglaText": "সেদিন মানুষকে অবহিত করা হবে সে যা সামনে প্রেরণ করেছে ও পশ্চাতে ছেড়ে দিয়েছে।",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ",
      "banglaText": "বরং মানুষ নিজেই তার নিজের সম্পর্কে চক্ষুমান।",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ",
      "banglaText": "যদিও সে তার অজুহাত পেশ করতে চাইবে।",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ",
      "banglaText": "তাড়াতাড়ি শিখে নেয়ার জন্যে আপনি দ্রুত ওহী আবৃত্তি করবেন না।",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ",
      "banglaText": "এর সংরক্ষণ ও পাঠ আমারই দায়িত্ব।",
      "englishText": ""
    },
    {
      "number": 18,
      "arabicText": "فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ",
      "banglaText": "অতঃপর আমি যখন তা পাঠ করি, তখন আপনি সেই পাঠের অনুসরণ করুন।",
      "englishText": ""
    },
    {
      "number": 19,
      "arabicText": "ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ",
      "banglaText": "এরপর বিশদ বর্ণনা আমারই দায়িত্ব।",
      "englishText": ""
    },
    {
      "number": 20,
      "arabicText": "كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ",
      "banglaText": "কখনও না, বরং তোমরা পার্থিব জীবনকে ভালবাস",
      "englishText": ""
    },
    {
      "number": 21,
      "arabicText": "وَتَذَرُونَ ٱلۡأٓخِرَةَ",
      "banglaText": "এবং পরকালকে উপেক্ষা কর।",
      "englishText": ""
    },
    {
      "number": 22,
      "arabicText": "وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ",
      "banglaText": "সেদিন অনেক মুখমন্ডল উজ্জ্বল হবে।",
      "englishText": ""
    },
    {
      "number": 23,
      "arabicText": "إِلَىٰ رَبِّهَا نَاظِرَةٞ",
      "banglaText": "তারা তার পালনকর্তার দিকে তাকিয়ে থাকবে।",
      "englishText": ""
    },
    {
      "number": 24,
      "arabicText": "وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ",
      "banglaText": "আর অনেক মুখমন্ডল সেদিন উদাস হয়ে পড়বে।",
      "englishText": ""
    },
    {
      "number": 25,
      "arabicText": "تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ",
      "banglaText": "তারা ধারণা করবে যে, তাদের সাথে কোমর-ভাঙ্গা আচরণ করা হবে।",
      "englishText": ""
    },
    {
      "number": 26,
      "arabicText": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ",
      "banglaText": "কখনও না, যখন প্রাণ কন্ঠাগত হবে।",
      "englishText": ""
    },
    {
      "number": 27,
      "arabicText": "وَقِيلَ مَنۡۜ رَاقٖ",
      "banglaText": "এবং বলা হবে, কে ঝাড়বে",
      "englishText": ""
    },
    {
      "number": 28,
      "arabicText": "وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ",
      "banglaText": "এবং সে মনে করবে যে, বিদায়ের ক্ষণ এসে গেছে।",
      "englishText": ""
    },
    {
      "number": 29,
      "arabicText": "وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
      "banglaText": "এবং গোছা গোছার সাথে জড়িত হয়ে যাবে।",
      "englishText": ""
    },
    {
      "number": 30,
      "arabicText": "إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ",
      "banglaText": "সেদিন, আপনার পালনকর্তার নিকট সবকিছু নীত হবে।",
      "englishText": ""
    },
    {
      "number": 31,
      "arabicText": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
      "banglaText": "সে বিশ্বাস করেনি এবং নামায পড়েনি",
      "englishText": ""
    },
    {
      "number": 32,
      "arabicText": "وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ",
      "banglaText": "পরন্ত মিথ্যারোপ করেছে ও পৃষ্ঠ প্রদর্শন করেছে।",
      "englishText": ""
    },
    {
      "number": 33,
      "arabicText": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ",
      "banglaText": "অতঃপর সে দম্ভভরে পরিবার-পরিজনের নিকট ফিরে গিয়েছে।",
      "englishText": ""
    },
    {
      "number": 34,
      "arabicText": "أَوۡلَىٰ لَكَ فَأَوۡلَىٰ",
      "banglaText": "তোমার দুর্ভোগের উপর দুর্ভোগ।",
      "englishText": ""
    },
    {
      "number": 35,
      "arabicText": "ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ",
      "banglaText": "অতঃপর, তোমার দুর্ভোগের উপর দূর্ভোগ।",
      "englishText": ""
    },
    {
      "number": 36,
      "arabicText": "أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى",
      "banglaText": "মানুষ কি মনে করে যে, তাকে এমনি ছেড়ে দেয়া হবে",
      "englishText": ""
    },
    {
      "number": 37,
      "arabicText": "أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ",
      "banglaText": "সে কি স্খলিত বীর্য ছিল না",
      "englishText": ""
    },
    {
      "number": 38,
      "arabicText": "ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ",
      "banglaText": "অতঃপর সে ছিল রক্তপিন্ড, অতঃপর আল্লাহ তাকে সৃষ্টি করেছেন এবং সুবিন্যস্ত করেছেন।",
      "englishText": ""
    },
    {
      "number": 39,
      "arabicText": "فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ",
      "banglaText": "অতঃপর তা থেকে সৃষ্টি করেছেন যুগল নর ও নারী।",
      "englishText": ""
    },
    {
      "number": 40,
      "arabicText": "أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ",
      "banglaText": "তবুও কি সেই আল্লাহ মৃতদেরকে জীবিত করতে সক্ষম নন",
      "englishText": ""
    }
  ],
  "banglaName": ""
}