{
  "surahNumber": 96,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 19,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ",
      "banglaText": "পাঠ করুন আপনার পালনকর্তার নামে যিনি সৃষ্টি করেছেন",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ",
      "banglaText": "সৃষ্টি করেছেন মানুষকে জমাট রক্ত থেকে।",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ",
      "banglaText": "পাঠ করুন, আপনার পালনকর্তা মহা দয়ালু",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ",
      "banglaText": "যিনি কলমের সাহায্যে শিক্ষা দিয়েছেন",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ",
      "banglaText": "শিক্ষা দিয়েছেন মানুষকে যা সে জানত না।",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ",
      "banglaText": "সত্যি সত্যি মানুষ সীমালংঘন করে",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ",
      "banglaText": "এ কারণে যে, সে নিজেকে অভাবমুক্ত মনে করে।",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ",
      "banglaText": "নিশ্চয় আপনার পালনকর্তার দিকেই প্রত্যাবর্তন হবে।",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ",
      "banglaText": "আপনি কি তাকে দেখেছেন, যে নিষেধ করে",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "عَبۡدًا إِذَا صَلَّىٰٓ",
      "banglaText": "এক বান্দাকে যখন সে নামায পড়ে",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ",
      "banglaText": "আপনি কি দেখেছেন যদি সে সৎপথে থাকে।",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ",
      "banglaText": "অথবা খোদাভীতি শিক্ষা দেয়।",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "banglaText": "আপনি কি দেখেছেন, যদি সে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "banglaText": "সে কি জানে না যে, আল্লাহ দেখেন",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ",
      "banglaText": "কখনই নয়, যদি সে বিরত না হয়, তবে আমি মস্তকের সামনের কেশগুচ্ছ ধরে হেঁচড়াবই",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ",
      "banglaText": "মিথ্যাচারী, পাপীর কেশগুচ্ছ।",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "فَلۡيَدۡعُ نَادِيَهُۥ",
      "banglaText": "অতএব, সে তার সভাসদদেরকে আহবান করুক।",
      "englishText": ""
    },
    {
      "number": 18,
      "arabicText": "سَنَدۡعُ ٱلزَّبَانِيَةَ",
      "banglaText": "আমিও আহবান করব জাহান্নামের প্রহরীদেরকে",
      "englishText": ""
    },
    {
      "number": 19,
      "arabicText": "كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩",
      "banglaText": "কখনই নয়, আপনি তার আনুগত্য করবেন না। আপনি সেজদা করুন ও আমার নৈকট্য অর্জন করুন।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}