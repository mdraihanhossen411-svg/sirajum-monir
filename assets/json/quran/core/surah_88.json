{
  "surahNumber": 88,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 26,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ",
      "banglaText": "আপনার কাছে আচ্ছন্নকারী কেয়ামতের বৃত্তান্ত পৌঁছেছে কি",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ",
      "banglaText": "অনেক মুখমন্ডল সেদিন হবে লাঞ্ছিত",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "عَامِلَةٞ نَّاصِبَةٞ",
      "banglaText": "ক্লিষ্ট, ক্লান্ত।",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "تَصۡلَىٰ نَارًا حَامِيَةٗ",
      "banglaText": "তারা জ্বলন্ত আগুনে পতিত হবে।",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ",
      "banglaText": "তাদেরকে ফুটন্ত নহর থেকে পান করানো হবে।",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ",
      "banglaText": "কন্টকপূর্ণ ঝাড় ব্যতীত তাদের জন্যে কোন খাদ্য নেই।",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ",
      "banglaText": "এটা তাদেরকে পুষ্ট করবে না এবং ক্ষুধায়ও উপকার করবে না।",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ",
      "banglaText": "অনেক মুখমন্ডল সেদিন হবে, সজীব",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "لِّسَعۡيِهَا رَاضِيَةٞ",
      "banglaText": "তাদের কর্মের কারণে সন্তুষ্ট।",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "فِي جَنَّةٍ عَالِيَةٖ",
      "banglaText": "তারা থাকবে, সুউচ্চ জান্নাতে।",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ",
      "banglaText": "তথায় শুনবে না কোন অসার কথাবার্তা।",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "فِيهَا عَيۡنٞ جَارِيَةٞ",
      "banglaText": "তথায় থাকবে প্রবাহিত ঝরণা।",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "فِيهَا سُرُرٞ مَّرۡفُوعَةٞ",
      "banglaText": "তথায় থাকবে উন্নত সুসজ্জিত আসন।",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "وَأَكۡوَابٞ مَّوۡضُوعَةٞ",
      "banglaText": "এবং সংরক্ষিত পানপাত্র",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "وَنَمَارِقُ مَصۡفُوفَةٞ",
      "banglaText": "এবং সারি সারি গালিচা",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "وَزَرَابِيُّ مَبۡثُوثَةٌ",
      "banglaText": "এবং বিস্তৃত বিছানো কার্পেট।",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ",
      "banglaText": "তারা কি উষ্ট্রের প্রতি লক্ষ্য করে না যে, তা কিভাবে সৃষ্টি করা হয়েছে",
      "englishText": ""
    },
    {
      "number": 18,
      "arabicText": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ",
      "banglaText": "এবং আকাশের প্রতি লক্ষ্য করে না যে, তা কিভাবে উচ্চ করা হয়েছে",
      "englishText": ""
    },
    {
      "number": 19,
      "arabicText": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ",
      "banglaText": "এবং পাহাড়ের দিকে যে, তা কিভাবে স্থাপন করা হয়েছে",
      "englishText": ""
    },
    {
      "number": 20,
      "arabicText": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ",
      "banglaText": "এবং পৃথিবীর দিকে যে, তা কিভাবে সমতল বিছানো হয়েছে",
      "englishText": ""
    },
    {
      "number": 21,
      "arabicText": "فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ",
      "banglaText": "অতএব, আপনি উপদেশ দিন, আপনি তো কেবল একজন উপদেশদাতা",
      "englishText": ""
    },
    {
      "number": 22,
      "arabicText": "لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ",
      "banglaText": "আপনি তাদের শাসক নন",
      "englishText": ""
    },
    {
      "number": 23,
      "arabicText": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "banglaText": "কিন্তু যে মুখ ফিরিয়ে নেয় ও কাফের হয়ে যায়",
      "englishText": ""
    },
    {
      "number": 24,
      "arabicText": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ",
      "banglaText": "আল্লাহ তাকে মহা আযাব দেবেন।",
      "englishText": ""
    },
    {
      "number": 25,
      "arabicText": "إِنَّ إِلَيۡنَآ إِيَابَهُمۡ",
      "banglaText": "নিশ্চয় তাদের প্রত্যাবর্তন আমারই নিকট",
      "englishText": ""
    },
    {
      "number": 26,
      "arabicText": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم",
      "banglaText": "অতঃপর তাদের হিসাব-নিকাশ আমারই দায়িত্ব।",
      "englishText": ""
    }
  ],
  "banglaName": ""
}