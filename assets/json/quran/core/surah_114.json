    {
      "number": 1,
      "arabicText": "قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "banglaText": "বলুন, আমি আশ্রয় গ্রহণ করিতেছি মানুষের পালনকর্তার",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "مَلِكِ ٱلنَّاسِ",
      "banglaText": "মানুষের অধিপতির",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "إِلَٰهِ ٱلنَّاسِ",
      "banglaText": "মানুষের মা’বুদের",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ",
      "banglaText": "তার অনিষ্ট থেকে, যে কুমন্ত্রণা দেয় ও আত্নগোপন করে",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ",
      "banglaText": "যে কুমন্ত্রণা দেয় মানুষের অন্তরে",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ",
      "banglaText": "জ্বিনের মধ্য থেকে অথবা মানুষের মধ্য থেকে।",
      "englishText": ""
    }
