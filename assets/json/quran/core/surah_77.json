{
  "surahNumber": 77,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 50,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا",
      "banglaText": "কল্যাণের জন্যে প্রেরিত বায়ুর শপথ",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "فَٱلۡعَٰصِفَٰتِ عَصۡفٗا",
      "banglaText": "সজোরে প্রবাহিত ঝটিকার শপথ",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "وَٱلنَّـٰشِرَٰتِ نَشۡرٗا",
      "banglaText": "মেঘবিস্তৃতকারী বায়ুর শপথ",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "فَٱلۡفَٰرِقَٰتِ فَرۡقٗا",
      "banglaText": "মেঘপুঞ্জ বিতরণকারী বায়ুর শপথ এবং",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا",
      "banglaText": "ওহী নিয়ে অবতরণকারী ফেরেশতাগণের শপথ",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "عُذۡرًا أَوۡ نُذۡرًا",
      "banglaText": "ওযর-আপত্তির অবকাশ না রাখার জন্যে অথবা সতর্ক করার জন্যে।",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ",
      "banglaText": "নিশ্চয়ই তোমাদেরকে প্রদত্ত ওয়াদা বাস্তবায়িত হবে।",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "فَإِذَا ٱلنُّجُومُ طُمِسَتۡ",
      "banglaText": "অতঃপর যখন নক্ষত্রসমুহ নির্বাপিত হবে",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ",
      "banglaText": "যখন আকাশ ছিদ্রযুক্ত হবে",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ",
      "banglaText": "যখন পর্বতমালাকে উড়িয়ে দেয়া হবে এবং",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ",
      "banglaText": "যখন রসূলগণের একত্রিত হওয়ার সময় নিরূপিত হবে",
      "englishText": ""
    },
    {
      "number": 12,
      "arabicText": "لِأَيِّ يَوۡمٍ أُجِّلَتۡ",
      "banglaText": "এসব বিষয় কোন দিবসের জন্যে স্থগিত রাখা হয়েছে",
      "englishText": ""
    },
    {
      "number": 13,
      "arabicText": "لِيَوۡمِ ٱلۡفَصۡلِ",
      "banglaText": "বিচার দিবসের জন্য।",
      "englishText": ""
    },
    {
      "number": 14,
      "arabicText": "وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ",
      "banglaText": "আপনি জানেন বিচার দিবস কি",
      "englishText": ""
    },
    {
      "number": 15,
      "arabicText": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
      "banglaText": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।",
      "englishText": ""
    },
    {
      "number": 16,
      "arabicText": "أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ",
      "banglaText": "আমি কি পূর্ববর্তীদেরকে ধ্বংস করিনি",
      "englishText": ""
    },
    {
      "number": 17,
      "arabicText": "ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ",
      "banglaText": "অতঃপর তাদের পশ্চাতে প্রেরণ করব পরবর্তীদেরকে।",
      "englishText": ""
    },
    {
      "number": 18,
      "arabicText": "كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ",
      "banglaText": "অপরাধীদের সাথে আমি এরূপই করে থাকি।",
      "englishText": ""
    },
    {
      "number": 19,
      "arabicText": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
      "banglaText": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।",
      "englishText": ""
    },
    {
      "number": 20,
      "arabicText": "أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ",
      "banglaText": "আমি কি তোমাদেরকে তুচ্ছ পানি থেকে সৃষ্টি করিনি",
      "englishText": ""
    },
    {
      "number": 21,
      "arabicText": "فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ",
      "banglaText": "অতঃপর আমি তা রেখেছি এক সংরক্ষিত আধারে",
      "englishText": ""
    },
    {
      "number": 22,
      "arabicText": "إِلَىٰ قَدَرٖ مَّعۡلُومٖ",
      "banglaText": "এক নির্দিষ্টকাল পর্যন্ত",
      "englishText": ""
    },
    {
      "number": 23,
      "arabicText": "فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ",
      "banglaText": "অতঃপর আমি পরিমিত আকারে সৃষ্টি করেছি, আমি কত সক্ষম স্রষ্টা",
      "englishText": ""
    },
    {
      "number": 24,
      "arabicText": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
      "banglaText": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।",
      "englishText": ""
    },
    {
      "number": 25,
      "arabicText": "أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا",
      "banglaText": "আমি কি পৃথিবীকে সৃষ্টি করিনি ধারণকারিণীরূপে",
      "englishText": ""
    },
    {
      "number": 26,
      "arabicText": "أَحۡيَآءٗ وَأَمۡوَٰتٗا",
      "banglaText": "জীবিত ও মৃতদেরকে",
      "englishText": ""
    },
    {
      "number": 27,
      "arabicText": "وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا",
      "banglaText": "আমি তাতে স্থাপন করেছি মজবুত সুউচ্চ পর্বতমালা এবং পান করিয়েছি তোমাদেরকে তৃষ্ণা নিবারণকারী সুপেয় পানি।",
      "englishText": ""
    },
    {
      "number": 28,
      "arabicText": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
      "banglaText": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।",
      "englishText": ""
    },
    {
      "number": 29,
      "arabicText": "ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "banglaText": "চল তোমরা তারই দিকে, যাকে তোমরা মিথ্যা বলতে।",
      "englishText": ""
    },
    {
      "number": 30,
      "arabicText": "ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ",
      "banglaText": "চল তোমরা তিন কুন্ডলীবিশিষ্ট ছায়ার দিকে",
      "englishText": ""
    },
    {
      "number": 31,
      "arabicText": "لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ",
      "banglaText": "যে ছায়া সুনিবিড় নয় এবং অগ্নির উত্তাপ থেকে রক্ষা করে না।",
      "englishText": ""
    },
    {
      "number": 32,
      "arabicText": "إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ",
      "banglaText": "এটা অট্টালিকা সদৃশ বৃহৎ স্ফুলিংগ নিক্ষেপ করবে।",
      "englishText": ""
    },
    {
      "number": 33,
      "arabicText": "كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ",
      "banglaText": "যেন সে পীতবর্ণ উষ্ট্রশ্রেণী।",
      "englishText": ""
    },
    {
      "number": 34,
      "arabicText": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
      "banglaText": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।",
      "englishText": ""
    },
    {
      "number": 35,
      "arabicText": "هَٰذَا يَوۡمُ لَا يَنطِقُونَ",
      "banglaText": "এটা এমন দিন, যেদিন কেউ কথা বলবে না।",
      "englishText": ""
    },
    {
      "number": 36,
      "arabicText": "وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ",
      "banglaText": "এবং কাউকে তওবা করার অনুমতি দেয়া হবে না।",
      "englishText": ""
    },
    {
      "number": 37,
      "arabicText": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
      "banglaText": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।",
      "englishText": ""
    },
    {
      "number": 38,
      "arabicText": "هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ",
      "banglaText": "এটা বিচার দিবস, আমি তোমাদেরকে এবং তোমাদের পূর্ববর্তীদেরকে একত্রিত করেছি।",
      "englishText": ""
    },
    {
      "number": 39,
      "arabicText": "فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ",
      "banglaText": "অতএব, তোমাদের কোন অপকৌশল থাকলে তা প্রয়োগ কর আমার কাছে।",
      "englishText": ""
    },
    {
      "number": 40,
      "arabicText": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
      "banglaText": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।",
      "englishText": ""
    },
    {
      "number": 41,
      "arabicText": "إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ",
      "banglaText": "নিশ্চয় খোদাভীরুরা থাকবে ছায়ায় এবং প্রস্রবণসমূহে",
      "englishText": ""
    },
    {
      "number": 42,
      "arabicText": "وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ",
      "banglaText": "এবং তাদের বাঞ্ছিত ফল-মূলের মধ্যে।",
      "englishText": ""
    },
    {
      "number": 43,
      "arabicText": "كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ",
      "banglaText": "বলা হবেঃ তোমরা যা করতে তার বিনিময়ে তৃপ্তির সাথে পানাহার কর।",
      "englishText": ""
    },
    {
      "number": 44,
      "arabicText": "إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",
      "banglaText": "এভাবেই আমি সৎকর্মশীলদেরকে পুরস্কৃত করে থাকি।",
      "englishText": ""
    },
    {
      "number": 45,
      "arabicText": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
      "banglaText": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।",
      "englishText": ""
    },
    {
      "number": 46,
      "arabicText": "كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ",
      "banglaText": "কাফেরগণ, তোমরা কিছুদিন খেয়ে নাও এবং ভোগ করে নাও। তোমরা তো অপরাধী।",
      "englishText": ""
    },
    {
      "number": 47,
      "arabicText": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
      "banglaText": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।",
      "englishText": ""
    },
    {
      "number": 48,
      "arabicText": "وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ",
      "banglaText": "যখন তাদেরকে বলা হয়, নত হও, তখন তারা নত হয় না।",
      "englishText": ""
    },
    {
      "number": 49,
      "arabicText": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ",
      "banglaText": "সেদিন মিথ্যারোপকারীদের দুর্ভোগ হবে।",
      "englishText": ""
    },
    {
      "number": 50,
      "arabicText": "فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ",
      "banglaText": "এখন কোন কথায় তারা এরপর বিশ্বাস স্থাপন করবে",
      "englishText": ""
    }
  ],
  "banglaName": ""
}