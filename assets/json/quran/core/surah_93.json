{
  "surahNumber": 93,
  "arabicName": "",
  "englishName": "",
  "totalAyah": 11,
  "ayahs": [
    {
      "number": 1,
      "arabicText": "وَٱلضُّحَىٰ",
      "banglaText": "শপথ পূর্বাহ্নের (দিনের উজ্জ্বল আলোর)।",
      "englishText": ""
    },
    {
      "number": 2,
      "arabicText": "وَٱلَّيۡلِ إِذَا سَجَىٰ",
      "banglaText": "এবং রাতের, যখন তা গভীর ও নিঝুম হয়।",
      "englishText": ""
    },
    {
      "number": 3,
      "arabicText": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "banglaText": "আপনার প্রতিপালক আপনাকে পরিত্যাগ করেননি এবং আপনার প্রতি অসন্তুষ্টও হননি।",
      "englishText": ""
    },
    {
      "number": 4,
      "arabicText": "وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ",
      "banglaText": "আর নিশ্চয়ই আপনার জন্য পরবর্তী সময় (বা পরকাল) পূর্ববর্তী সময় (বা ইহকাল) অপেক্ষা উত্তম।",
      "englishText": ""
    },
    {
      "number": 5,
      "arabicText": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ",
      "banglaText": "আর অচিরেই আপনার প্রতিপালক আপনাকে (এত বিপুল) দান করবেন যে আপনি সন্তুষ্ট হয়ে যাবেন।",
      "englishText": ""
    },
    {
      "number": 6,
      "arabicText": "أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ",
      "banglaText": "তিনি কি আপনাকে এতীম হিসেবে পাননি? অতঃপর তিনি আশ্রয় দান করেছেন।",
      "englishText": ""
    },
    {
      "number": 7,
      "arabicText": "وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ",
      "banglaText": "এবং তিনি আপনাকে পেয়েছেন (শরীয়তের বিস্তারিত বিধান সম্পর্কে) অনবহিত (কিংবা স্বীয় প্রেমে বিভোর), অতঃপর তিনি পথনির্দেশ করেছেন।",
      "englishText": ""
    },
    {
      "number": 8,
      "arabicText": "وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ",
      "banglaText": "এবং তিনি আপনাকে পেয়েছেন অভাবগ্রস্ত অবস্থায়, অতঃপর অভাবমুক্ত করেছেন।",
      "englishText": ""
    },
    {
      "number": 9,
      "arabicText": "فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ",
      "banglaText": "অতএব, আপনি এতীমের প্রতি কঠোরতা করবেন না।",
      "englishText": ""
    },
    {
      "number": 10,
      "arabicText": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ",
      "banglaText": "এবং সাহায্যপ্রার্থীকে ধমক দেবেন না।",
      "englishText": ""
    },
    {
      "number": 11,
      "arabicText": "وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ",
      "banglaText": "এবং আপনার প্রতিপালকের নিয়ামতের কথা কৃতজ্ঞতার সাথে প্রচার করুন।",
      "englishText": ""
    }
  ],
  "banglaName": "আদ-দুহা"
}